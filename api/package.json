{
  "name": "@aptt/cantonese-dictionary-api",
  "version": "1.0.0",
  "description": "Source code of https://cantonese-dictionary-api.vercel.app/",
  "type": "module",
  "private": true,
  "scripts": {
    "develop": "tsx --watch scripts/develop.ts",
    "build:vercel": "rollup --config rollup.config.mjs",
    "prettier": "prettier --ignore-path .gitignore --check .",
    "eslint": "eslint .",
    "lint": "concurrently --group --prefix-colors green,magenta npm:prettier npm:eslint",
    "deploy:vercel": "pnpx vercel deploy vercel/",
    "vercel": "pnpm build:vercel && pnpm vercel:deploy"
  },
  "keywords": [
    "cantonese",
    "dictionary"
  ],
  "author": "aptt",
  "license": "GPL-3.0",
  "dependencies": {
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.4",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@libsql/client": "0.17.0",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@rollup/plugin-virtual": "3.0.2",
    "@typescript-eslint/parser": "8.56.1",
    "concurrently": "9.2.1",
    "eslint": "10.0.3",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-jsdoc": "1.8.0",
    "rollup": "4.59.0",
    "rollup-plugin-copy": "3.5.0",
    "tsx": "4.21.0",
    "typescript-eslint": "8.56.1"
  }
}
