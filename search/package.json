{
  "name": "@aptt/cantonese-dictionary-search",
  "version": "1.0.0",
  "description": "Source data processing for https://cantonese-dictionary-app.vercel.app/",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest",
    "build:local": "tsx scripts/build_local.mjs",
    "build:remote": "tsx -r dotenv/config scripts/build_remote.ts",
    "build": "pnpm build:local",
    "develop": "nodemon -e mjs,ts -x 'pnpm build'",
    "prettier": "prettier --ignore-path .gitignore --check .",
    "eslint": "eslint .",
    "lint": "concurrently --group --prefix-colors green,magenta npm:prettier npm:eslint",
    "get-data:canto": "curl -so ./data_source_files/canto.txt https://raw.githubusercontent.com/amadeusine/cc-canto-data/master/cccanto-webdist.txt",
    "get-data:cedict_canto_readings": "curl -so ./data_source_files/cedict_canto_readings.txt https://raw.githubusercontent.com/amadeusine/cc-canto-data/master/cccedict-canto-readings.txt",
    "get-data:cedict": "curl -s ./data_source_files/cedict.txt.gz 'https://www.mdbg.net/chinese/export/cedict/cedict_1_0_ts_utf-8_mdbg.txt.gz' | gzip -cd > data_source_files/cedict.txt",
    "get-data:phrases_simplified": "curl -so ./data_source_files/phrases-simplified.txt https://raw.githubusercontent.com/stroke-input/stroke-input-data/refs/heads/master/phrases-simplified.txt",
    "get-data:ranking_simplified": "curl -so ./data_source_files/ranking-simplified.txt https://raw.githubusercontent.com/stroke-input/stroke-input-data/refs/heads/master/ranking-simplified.txt",
    "get-data:ranking_traditional": "curl -so ./data_source_files/ranking-traditional.txt https://raw.githubusercontent.com/stroke-input/stroke-input-data/refs/heads/master/ranking-traditional.txt",
    "get-data": "mkdir -p data_source_files && concurrently --group --prefix-colors red,magenta,yellow,green,cyan,blue --names 'canto,cedict,canto readings,phrases,ranking (simplified),ranking (traditional)' npm:get-data:canto npm:get-data:cedict npm:get-data:cedict_canto_readings npm:get-data:phrases_simplified npm:get-data:ranking_simplified npm:get-data:ranking_traditional"
  },
  "keywords": [
    "cantonese",
    "dictionary"
  ],
  "author": "aptt",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@libsql/client": "0.17.4",
    "@typescript-eslint/parser": "8.61.1",
    "concurrently": "10.0.3",
    "dotenv": "17.4.2",
    "eslint": "10.5.0",
    "globals": "17.6.0",
    "nodemon": "3.1.14",
    "prettier": "3.8.4",
    "prettier-plugin-jsdoc": "1.8.1",
    "sqlite3": "6.0.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.9"
  }
}
